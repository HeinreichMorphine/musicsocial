@startuml
title Settings Page Activity Diagram
skinparam swimlaneBorderColor black
skinparam swimlaneTitleBackgroundColor #EEE
skinparam activityBackgroundColor #FEFEFE
skinparam activityArrowColor #333
skinparam activityBorderColor #333
skinparam nodesep 50
skinparam ranksep 50
scale 1.5
skinparam defaultFontSize 18
|User|
|System| (Web App & Database)
|External_API| (Spotify/Google)

|User|
start
:Access Settings Page;
|System|
:Display Settings Sections:
1. Email Verification Status
2. Connect Social Accounts
3. Profile Information (Name/Email)
4. Update Password
5. Delete Account;

|User|
split
    :Update Profile Info (Name/Email);
    |System|
    :Validate Input;
    if (Email Changed?) then (Yes)
        :Update User Record;
        :Reset Email Verified Status;
        :Send Verification Email;
    else (No)
        :Update User Record;
    endif
    :Return Success Message;

split again
    :Manage Connected Accounts;
    if (Link New Account?) then (Yes)
        :Click "Connect Spotify/Google";
        |System|
        :Redirect to Provider;
        |External_API|
        :Authenticate User;
        :Return Callback;
        |System|
        :Link Provider ID to User;
    else (Unlink Account)
        :Click "Disconnect";
        |System|
        :Remove Provider ID/Token;
    endif
    :Update View;

split again
    :Resend Verification Email;
    |System|
    :Trigger "Verification Email" Event;
    :Show "Link Sent" Message;

split again
    :Update Password;
    :Fill Current & New Password;
    |System|
    :Validate Current Password;
    :Update Password Hash;
    :Logout Other Sessions (Optional);

split again
    :Update Avatar/Banner;
    |System|
    :Store Image (Storage);
    :Update Path;

end split

|System|
:Redirect/Refresh Page;
stop
@enduml
