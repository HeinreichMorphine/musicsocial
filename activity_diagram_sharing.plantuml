@startuml
title Music Sharing Module Activity Diagram
skinparam swimlaneBorderColor black
skinparam swimlaneTitleBackgroundColor #EEE
skinparam activityBackgroundColor #FEFEFE
skinparam activityArrowColor #333
skinparam activityBorderColor #333

|User|
|System| (Web App & Database)
|External_API| (Spotify, Discogs, MusicBrainz, YouTube)

|User|
start
:Submit Share (Spotify Link);
|System|
:Validate Input;
:Call SpotifyService.getTrack();
:Request Track Metadata (Service);
|External_API|
:Get Track Details (Spotify);
|System|
:Check/FirstOrCreate Song (Basic Data);
:Call getGenresForTrack();
|External_API|
:Get Artist/Album Genres (Spotify);
:Get Styles/Genres (Discogs);
|System|
if (Genres < 3?) then (Yes)
    |External_API|
    :Get Artist Genres (MusicBrainz Fallback);
else (No)
endif
|System|
:Clean and Merge Genres;
:Enhance Genres (Controller Level);
|External_API|
:Extract YouTube Link (Youtube);
|System|
:Merge All Genres;
:Update Song Metadata (Database);
:Create Share Record (Database);
:Return Success;
stop
@enduml
