@startuml
title Home Page (Feed) Activity Diagram
skinparam swimlaneBorderColor black
skinparam swimlaneTitleBackgroundColor #EEE
skinparam activityBackgroundColor #FEFEFE
skinparam activityArrowColor #333
skinparam activityBorderColor #333
skinparam nodesep 50
skinparam ranksep 50

|User|
|System| (Web App & Database)
|Spotify| (External App / API)

|User|
start
:Access Home Page;
|System|
:Fetch Shares (Paginated);
:Select Shares with Relations;
:Return View with Shares;

|User|
if (User Action) is (Comment) then
    |User|
    :Click **Comment**;
    |System|
    :Show Comment Input;
    |User|
    :Submit Comment;
    |System|
    :Store Comment;
    :Update View;
    stop
elseif (User Action) is (Song Link) then
    |User|
    :Click Song Link (Spotify/YouTube);
    |System|
    :Redirect to External URL;
    stop
elseif (User Action) is (Like / Dislike) then
    |User|
    :Click **Like / Dislike**;
    |System|
    :Toggle Status;
    :Update Counts & Icon;
    stop
elseif (User Action) is (Save) then
    |User|
    :Click **Save (Bookmark)**;
    |System|
    :Toggle Bookmark Status;
    :Update Icon (Yellow);
    stop
elseif (User Action) is (Add to Playlist) then
    |User|
    :Click **Add to Playlist**;
    |System|
    :Show Playlist Modal;
    |User|
    :Select Playlist & Confirm;
    |System|
    :Add Song to Playlist (API);
    |Spotify|
    :Save to User Library;
    |System|
    :Show Success Message;
    stop
endif
@enduml
