@startuml
title Right Sidebar Activity Diagram
skinparam swimlaneBorderColor black
skinparam swimlaneTitleBackgroundColor #EEE
skinparam activityBackgroundColor #FEFEFE
skinparam activityArrowColor #333
skinparam activityBorderColor #333
skinparam nodesep 50
skinparam ranksep 50

|User|
|System| (Web App & Database)

|User|
start
:Load Page with Sidebar;
|System|
fork
    :Fetch "Who to Follow";
    note right
        Logic:
        1. Identify "Taste Neighbors" (Shared Likes)
        2. Filter Already Followed
        3. Sort by Popularity
        4. Backfill with Random Users (if < 5)
    end note
fork again
    :Fetch "Suggested for You";
    note right
        Top Rated Songs from
        Recommendation Service
    end note
end fork

:Render Sidebar (Who to Follow + Suggestions);

|User|
split
    :Click "Follow" User;
    |System|
    :Create Follow Relationship;
    :Update Button State;
split again
    :Click Suggested Song;
    |System|
    :Redirect to Song Details;
end split
stop
@enduml
