@startuml
title Feed & Interaction Module Activity Diagram
skinparam swimlaneBorderColor black
skinparam swimlaneTitleBackgroundColor #EEE
skinparam activityBackgroundColor #FEFEFE
skinparam activityArrowColor #333
skinparam activityBorderColor #333
skinparam nodesep 50
skinparam ranksep 50

|User|
|System| (Web App & Database)

|User|
start
:Access Dashboard/Feed;
|System|
:Get Authenticated User;

:Fetch Following IDs;
:Query Shares (User + Following);
:Filter Out Disliked Shares;
:Eager Load Relations (Song, User, Likes ,Saved);
:Order By Latest;
:Paginate Results (20 per page);

:Compile View Data (Shares);
:Render Dashboard View;

|User|
:View Feed;
split
    :Scroll / Click Pagination Links;
    |System|
    :Fetch Next Page of Shares;
    :Update Feed View;
split again
    :Interact (Like/Dislike/Comment/Save);
    :See Home Diagram;
end split

stop
@enduml
