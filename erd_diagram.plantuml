@startuml
skinparam linetype ortho
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundcorner 10

' Remove the 'E' circle
hide circle

' Spacing control
skinparam nodesep 120
skinparam ranksep 100

' --- ENTITIES ---

entity "User" as users {
  *id : integer <<PK, not null>>
  --
  *name : string
  *email : string
  email_verified_at : timestamp
  *password : string
  profile_picture : string
  avatar : string
  cover_photo_path : string
  is_banned : boolean
  google_id : string
  spotify_id : string
  spotify_token : text
  spotify_refresh_token : text
  remember_token : string
}

entity "Share" as shares {
  *id : integer <<PK, not null>>
  --
  *user_id : integer <<FK, not null>>
  *song_id : integer <<FK, not null>>
  caption : text
  type : string
}

entity "Song" as songs {
  *id : integer <<PK, not null>>
  --
  track_name : string
  artist_name : string
  album_art_url : string
  spotify_track_id : string <<Unique>>
  youtube_video_id : string <<Unique>>
  spotify_url : string
  youtube_url : string
  genres : json
  release_date : date
}

entity "Like" as likes {
  *user_id : integer <<PK, FK, not null>>
  *share_id : integer <<PK, FK, not null>>
  --
}

entity "Dislike" as dislikes {
  *user_id : integer <<FK, not null>>
  *share_id : integer <<FK, not null>>
  --
}

entity "Bookmark" as bookmarks {
  *id : integer <<PK, not null>>
  --
  *user_id : integer <<FK, not null>>
  *share_id : integer <<FK, not null>>
}


entity "Comment" as comments {
  *id : integer <<PK, not null>>
  --
  *user_id : integer <<FK, not null>>
  *share_id : integer <<FK, not null>>
  parent_id : integer <<FK>>
  body : text
}

entity "CommentThread" as comment_threads {
  *id : integer <<PK, not null>>
  --
  *comment_id : integer <<FK, not null>>
  parent_id : integer <<FK>>
}

entity "Admin" as admins {
  *id : integer <<PK, not null>>
  --
  *name : string
  *email : string
  *password : string
}

entity "Follower" as followers {
  *user_id : integer <<PK, FK, not null>>
  *follower_id : integer <<PK, FK, not null>>
  --
}

entity "Notification" as notifications {
  *id : uuid <<PK, not null>>
  --
  *type : string
  *notifiable_type : string
  *notifiable_id : integer
  *data : text
  read_at : timestamp
}

' --- LAYOUT GRID ---
' Goal: Center User and Share, distribute others to sides

' Row 1: Admin - User - Notification
users -[hidden]left- admins
users -[hidden]right- notifications

' Row 2: Follower - Share - Song
' Connection to top
users -[hidden]down- shares

' Side alignments for Row 2
shares -[hidden]left- followers
shares -[hidden]right- songs

' Side interactions (Like/Dislike left, Bookmark/Feedback right)
likes -[hidden]up- followers
likes -[hidden]down- dislikes

bookmarks -[hidden]up- songs
bookmarks -[hidden]down- comment_threads

' Align interactions with Share
shares -[hidden]left- likes
shares -[hidden]left- dislikes

shares -[hidden]right- bookmarks

shares -[hidden]down- comments
comments -[hidden]down- comment_threads


entity "SongInteraction" as song_interactions {
  *id : integer <<PK, not null>>
  --
  *user_id : integer <<FK, not null>>
  *song_id : integer <<FK, not null>>
  type : enum('listen', 'like', 'dislike')
  created_at : timestamp
}

song_interactions -[hidden]up- songs
users ||-right-o{ song_interactions : "interacts"
songs ||-down-o{ song_interactions : "has"


' --- RELATIONSHIPS ---

' 1. Central Spine
users ||-down-o{ shares : "creates"
shares ||-down-o{ comments : "has"
comments ||-down-o{ comment_threads : "has reply"

' Comment self-reference (replies) moved to left
comments ||-left-o{ comments : "replies"
users ||-down-o{ comments : "writes"

' Admin Relationships
admins ||-down-o{ users : "moderates"
admins ||-down-o{ comments : "checks"
admins ||-right-o{ notifications : "receives"
users ||-right-o{ notifications : "receives"

' 2. Left Side Components
users ||-left-o{ followers : "follows"
users ||-left-o{ followers : "followed by"

' Like/Dislike (Left of Share)
users ||-left-o{ likes : "gives"
shares ||-left-o{ likes : "receives"

users ||-left-o{ dislikes : "gives"
shares ||-left-o{ dislikes : "receives"

' 3. Right Side Components
shares }o-right-|| songs : "includes"

' Bookmark/Feedback (Right of Share)
users ||-right-o{ bookmarks : "saves"
shares ||-right-o{ bookmarks : "bookmarked"


@enduml
