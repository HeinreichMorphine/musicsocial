@startuml
title Admin User Management Activity Diagram
skinparam swimlaneBorderColor black
skinparam swimlaneTitleBackgroundColor #EEE
skinparam activityBackgroundColor #FEFEFE
skinparam activityArrowColor #333
skinparam activityBorderColor #333
skinparam nodesep 50
skinparam ranksep 50

|Admin_User|
|System| (Web App & Database)

|Admin_User|
start
:Access User Management;
|System|
:Fetch Users (Paginated);
:Render User List;
|Admin_User|
:View Users;
if (Action?) then (Ban/Unban)
    :Click Ban/Unban Button;
    |System|
    :Toggle is_banned Status;
    :Update User Record;
    :Return Success Message;
else (Delete)
    :Click Delete Button;
    |System|
    :Delete User Record;
    :Return Success Message;
endif
|Admin_User|
:View Updated List;
stop
@enduml
